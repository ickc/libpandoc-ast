cabal-version:      3.0
name:               panir-schema
version:            0.1.0
synopsis:           Writes the schema and test corpus of pandoc's document AST
license:            BSD-3-Clause
author:             Kolen Cheung
build-type:         Simple

executable panir-schema
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:    SchemaTH
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >=4.18 && <5,
                    aeson >=2.1 && <2.3,
                    bytestring,
                    containers,
                    directory,
                    filepath,
                    pandoc-types >=1.23 && <1.24,
                    QuickCheck >=2.14 && <2.19,
                    template-haskell,
                    text
